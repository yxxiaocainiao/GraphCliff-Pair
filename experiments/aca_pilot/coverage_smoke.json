{
  "status": "preregistered direct GraphCliff ACA-MSE transfer; validation only",
  "datasets": [
    "CHEMBL2047_EC50"
  ],
  "seeds": [
    42
  ],
  "split_seed": 42,
  "hidden_size": 32,
  "num_layers": 2,
  "heads": 4,
  "epochs": 2,
  "schedule_epochs": 100,
  "warmup_epochs": 10,
  "patience": 15,
  "batch_size": 32,
  "lr": 0.0001,
  "min_lr": 1e-06,
  "weight_decay": 1e-05,
  "betas": [
    0.9,
    0.95
  ],
  "gradient_clip": 1,
  "alpha_max": 1,
  "weight_cap": 3,
  "arms": [
    {
      "name": "mse",
      "variant": "direct",
      "readout": "sag",
      "loss": "mse",
      "aca_alpha": 0.0
    },
    {
      "name": "aca",
      "variant": "direct",
      "readout": "sag",
      "loss": "mse",
      "aca_alpha": 0.1
    }
  ],
  "cliff_lower_log10": 1.0,
  "cliff_upper_log10": 1.0,
  "limit_train_queries": 64,
  "limit_valid_queries": 40
}
